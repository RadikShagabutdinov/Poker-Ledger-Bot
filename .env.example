# Server (SPEC §16.2). Copy to .env and fill in; never commit real secrets.
NODE_ENV=development
BOT_TOKEN=
BOT_USERNAME=poker_ledger_bot
MINIAPP_SHORT_NAME=app
# Optional: Mini App URL for the web_app button in private chats.
MINIAPP_URL=
# CORS origin of the Mini App; required when NODE_ENV=production.
MINIAPP_ORIGIN=https://<github-user>.github.io
DATABASE_PATH=./data/poker.db
# HTTP API port (served under /api).
PORT=3000
LOG_LEVEL=info
# Dev only (SPEC §16.6). Rejected when NODE_ENV=production.
DEV_SKIP_INIT_DATA_CHECK=false

# Mini App (SPEC §16.3), read by Vite at build time.
# Empty in dev: the Vite dev server forwards /api to the local server on PORT.
VITE_API_URL=
VITE_BASE=/
# Dev mock of Telegram in the browser (SPEC §16.6), needs DEV_SKIP_INIT_DATA_CHECK=true.
# The server still checks chat membership with the Bot API: use your own Telegram id and
# first name (the server stores the name it receives).
VITE_DEV_USER_ID=
VITE_DEV_FIRST_NAME=
# Start screen: c_<chatId>, g_<gameId>, s_<chatId> or empty.
VITE_DEV_START_PARAM=
VITE_DEV_LANGUAGE=ru

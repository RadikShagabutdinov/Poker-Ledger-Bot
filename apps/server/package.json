{
  "name": "@pokerledger/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsdown",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@hono/node-server": "^2.1.3",
    "@pokerledger/core": "workspace:*",
    "@pokerledger/shared": "workspace:*",
    "@tma.js/init-data-node": "^2.0.8",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "grammy": "^1.46.0",
    "hono": "^4.13.12",
    "i18next": "^26.4.2",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15"
  }
}
